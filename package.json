{
  "name": "mafatih",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arabic touch-typing trainer with diacritics, built on Quranic text. A keybr for لوحة المفاتيح.",
  "scripts": {
    "build": "pnpm build:corpus && tsc --noEmit && vite build",
    "build:corpus": "tsx scripts/build-corpus.ts",
    "check": "pnpm exec biome check ./",
    "check:nix": "nix-shell -p biome --run \"biome check ./\"",
    "check:nix:write": "nix-shell -p biome --run \"biome check --write --unsafe ./\"",
    "check:write": "pnpm exec biome check --write --unsafe ./",
    "cypress:nix": "nix-shell -p cypress --run 'CYPRESS_RUN_BINARY=$(command -v Cypress) pnpm exec cypress run --e2e'",
    "cypress:nix:open": "nix-shell -p cypress --run 'CYPRESS_RUN_BINARY=$(command -v Cypress) pnpm exec cypress open'",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --e2e",
    "dev": "pnpm build:corpus && vite",
    "preview": "vite preview",
    "test": "pnpm build:corpus && node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "14.5.4",
    "cypress-vite": "^1.10.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.11.0"
  }
}

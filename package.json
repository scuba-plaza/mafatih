{
  "name": "mafatih",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Arabic touch-typing trainer: type the Qur'an in Recitation, drill everyday words in Practice.",
  "scripts": {
    "dev": "pnpm build:data && vite",
    "build": "pnpm build:data && vite build",
    "build:data": "tsx scripts/build-data.ts",
    "preview": "vite preview",
    "check": "biome check ./",
    "check:write": "biome check --write ./",
    "check:style": "tsx scripts/check-style.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "pnpm build:data && vitest run",
    "e2e": "pnpm build && playwright test",
    "verify": "pnpm check && pnpm check:style && pnpm build && pnpm typecheck && pnpm test && playwright test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxc-parser": "^0.158.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}

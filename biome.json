{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "./src/**",
      "./scripts/**",
      "./e2e/**",
      "./index.html",
      "./biome.json",
      "./package.json",
      "./tsconfig.json",
      "./vite.config.ts",
      "./vitest.config.ts",
      "./playwright.config.ts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" },
      "suspicious": { "noExplicitAny": "error" },
      "style": { "useBlockStatements": "error" }
    }
  },
  "formatter": {
    "enabled": true,
    "indentWidth": 2,
    "indentStyle": "space",
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "css": { "parser": { "tailwindDirectives": true } }
}
